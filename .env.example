# Copy to .env and fill in. Never commit .env.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Set after registering a webhook for the app (needed for signature verification)
PAYPAL_WEBHOOK_ID=

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://guardrail:guardrail@localhost:5433/guardrail

# --- Verifier ---
# jev | llm | stub   (llm = GroqCloud fallback, stub = offline)
VERIFIER=llm
GROQ_API_KEY=
INJECTION_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# Only needed if the agent runs on the Claude Agent SDK with an API key
ANTHROPIC_API_KEY=
LLM_VERIFIER_MODEL=openai/gpt-oss-20b
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=Jev-1.13.0

# --- Gateway ---
# The "default" agent's key for the MCP endpoint (more agents, each with its own key and cap,
# can be created on the web app's Agents page). It cannot call approval endpoints.
# Changing it revokes the previous value on the next start. Use a long random value.
AGENT_API_KEY=change-me-agent
# Optional: vault id from `spikes/paypal_spikes.py vault` (pays without per-order redirect)
PAYPAL_VAULT_ID=
# Password for the single demo user who approves intents and carts in the web UI.
USER_PASSWORD=change-me-user
# Ed25519 private key used to sign intents, approvals and receipts (generated on first run if missing)
SIGNING_KEY_PATH=keys/gateway_ed25519.pem
# ES256 key for AP2 mandates (generated on first run if missing)
AP2_SIGNING_KEY_PATH=keys/gateway_es256.pem
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
MERCHANT_BASE_URL=http://localhost:8100
# Minutes a held cart waits for your decision before it expires
APPROVAL_TTL_MINUTES=30
# Sign-in sessions (web app and seller desk): end after this much inactivity, and at most after
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
# text | json (one JSON object per log line, for hosted logs)
LOG_FORMAT=text
# Database the tests use (dropped and recreated on each test run; never your real one)
TEST_DATABASE_URL=postgresql+psycopg://guardrail:guardrail@localhost:5433/guardrail_test
# Hosted only (no disk): signing keys pasted as secrets (PEM or base64); see docs/deploy-render.md
# SIGNING_KEY_PEM=
# AP2_SIGNING_KEY_PEM=

# --- Dispute desk (seller side, separate service on :8200) ---
# Seller staff login (separate from USER_PASSWORD, the buyer's login)
SELLER_PASSWORD=change-me-seller
# The desk's own public address (used for webhook links and the startup secret check)
DESK_PUBLIC_URL=http://localhost:8200
# Where the desk verifies buyers' receipts (the gateway's public endpoint)
GATEWAY_PUBLIC_URL=http://localhost:8000
# Optional: pin the gateway's public key (from GET /api/public-key)
GATEWAY_PUBLIC_KEY=
# Accept webhooks PayPal cannot sign-verify (simulate-event, or no PAYPAL_WEBHOOK_ID); labelled unverified
DESK_ALLOW_UNVERIFIED_WEBHOOKS=false

# --- Passkeys (WebAuthn): approvals signed on the user's own device ---
# rp id = the web app's host; origin defaults to WEB_BASE_URL
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=
# auto: required once a passkey is registered (default); always; never (scripted rehearsals only)
REQUIRE_PASSKEY=auto

# --- Checkout guard (browser agents on ordinary shops; runs as the agent's MCP server) ---
# GUARD_GATEWAY_URL=http://localhost:8000
# GUARD_AGENT_KEY=   (a "browser" agent's key from the Agents page; give it to the guard, not the agent)
# GUARD_HEADLESS=0

# --- Outside witness for the audit log (RFC 3161 timestamp authorities) ---
# Seconds between anchors (0 disables). Tokens verify with: openssl ts -verify
ANCHOR_INTERVAL_SECONDS=300
ANCHOR_TSA_URLS=http://timestamp.digicert.com,https://freetsa.org/tsr
